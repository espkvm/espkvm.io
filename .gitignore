# Local preview of the flasher: a real merged image plus a manifest pointing at
# it, so flash.html can be exercised before CI has published anything.
_preview/
_preview_flash.html

# Pages build output
_site/

# Generated by tools/build-site.py from _pages/, _posts/ and _partials/.
# The published site is assembled by CI, so none of this is committed.
/index.html
/flash/index.html
/serial/index.html
/tools/index.html
/blog/
/sitemap.xml

# Posts that are written but not published yet. Move one back into _posts/ to
# put it on the site.
_drafts/

# Editor leftovers
*.kate-swp
